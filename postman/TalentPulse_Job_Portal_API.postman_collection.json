    "name": "TalentPulse Job Portal & ATS API (Auspify Task 6)",
    "description": "Comprehensive REST API Collection for Auspify Technologies Full Stack Internship Task 6 (Job Portal & Applicant Tracking System). Developed by Yallari Gavada.\n\nPrerequisites:\n1. Backend running on http://localhost:5004\n2. Run 'POST 1. Login (Admin)' to authenticate. The response test script automatically stores the JWT token in your environment variable 'talentpulse_token'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5004",
      "type": "string"
    },
    {
      "key": "talentpulse_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "POST Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.token) {",
                  "    pm.collectionVariables.set('talentpulse_token', res.token);",
                  "    console.log('Saved talentpulse_token for Admin');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@auspify.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
